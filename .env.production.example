# Production env file — copy this to ".env" on the SERVER, next to
# docker-compose.prod.yml, and fill in real values. Never commit the real
# file (it's gitignored) and never copy it back to your laptop's repo.
#
# `docker compose -f docker-compose.prod.yml up -d --build` reads this
# automatically: MYSQL_*/NEXT_PUBLIC_* are used for variable substitution in
# the compose file itself, everything else is passed straight into the app
# container.

# ---- MySQL (app's own database, used to build DATABASE_URL — see
# docker-compose.prod.yml) ----
MYSQL_DATABASE="venrixmc"
MYSQL_USER="venrix"
MYSQL_PASSWORD="change-this-to-a-strong-random-password"
MYSQL_ROOT_PASSWORD="change-this-to-a-different-strong-random-password"

# ---- Sessions ----
# Generate with: openssl rand -base64 32
SESSION_SECRET="change-this-to-a-random-32-char-secret-value"
SESSION_COOKIE_NAME="venrix_session"

# ---- Public site config (baked into the client bundle at build time —
# changing these requires rebuilding the image, see deploy/deploy.sh) ----
NEXT_PUBLIC_SERVER_IP="play.venrixmc.uk"
NEXT_PUBLIC_STORE_URL="https://store.venrixmc.uk/"
NEXT_PUBLIC_DISCORD_INVITE="https://discord.gg/sDhGS4EVJw"
NEXT_PUBLIC_DISCORD_SERVER_ID=""

# ---- Discord bot (esiti candidature / appeal) ----
# Manda in DM al giocatore l'esito di candidatura/appeal e lo pubblica in un
# canale. Serve "SERVER MEMBERS INTENT" attivo e il bot invitato nel server con
# i permessi View Channels + Send Messages. Server e canali si scelgono da
# /dashboard/settings. Vuoto = notifiche disattivate.
DISCORD_BOT_TOKEN=""

# ---- Discord account linking (optional) ----
# OAuth2 redirect must be exactly "{APP_URL}/api/auth/discord/callback".
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# mcsrvstat API base (no key required)
MCSRVSTAT_API_URL="https://api.mcsrvstat.us/2/play.venrixmc.uk"

# ---- LiteBans (optional) ----
# Connects read-only, directly to the MySQL database the LiteBans plugin
# writes to on the Minecraft server — NOT the venrixmc database above.
LITEBANS_DATABASE_URL=""
LITEBANS_TABLE_PREFIX="litebans_"
LITEBANS_BAN_ID_PREFIX="F"
LITEBANS_BAN_ID_PAD="5"

# ---- AI detector (optional) ----
# Sapling API key from https://sapling.ai/user/settings (free plan: 50,000
# characters/day, 250,000/month). When set, every staff application is checked
# for AI-written text and the estimate is shown in the dashboard. Leave empty
# to disable.
SAPLING_API_KEY=""

# ---- App ----
NODE_ENV="production"
APP_URL="https://venrixmc.uk"
