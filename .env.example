# ---- Database (MySQL via Prisma) ----
DATABASE_URL="mysql://venrix:venrix@localhost:3306/venrixmc"

# ---- Redis ----
# Standard ioredis connection string (local or self-hosted)
REDIS_URL="redis://localhost:6379"

# Set to "true" to skip real Redis entirely and use an in-process in-memory
# shim instead (src/lib/memoryRedis.ts). Handy for local dev without Docker:
# sessions/cache/rate-limit/lock/pub-sub all keep working, but data resets on
# every restart and isn't shared across multiple server instances.
# NEVER set this to true in production.
REDIS_MOCK="false"

# ---- Sessions ----
# 32+ char random secret used to encrypt the iron-session cookie.
# Generate with: openssl rand -base64 32
SESSION_SECRET="change-this-to-a-random-32-char-secret-value"
SESSION_COOKIE_NAME="venrix_session"

# ---- Public site config ----
NEXT_PUBLIC_SERVER_IP="play.venrixmc.uk"
NEXT_PUBLIC_STORE_URL="https://store.venrixmc.uk/"
NEXT_PUBLIC_DISCORD_INVITE="https://discord.gg/sDhGS4EVJw"
NEXT_PUBLIC_DISCORD_SERVER_ID=""

# ---- Discord bot (esiti candidature / appeal) ----
# Token del bot usato per mandare in DM al giocatore l'esito della sua
# candidatura staff o del suo ban appeal e per pubblicarlo in un canale.
# Setup:
#   1. https://discord.com/developers/applications → la tua app → Bot → Reset Token
#   2. attiva "SERVER MEMBERS INTENT" (serve a risolvere l'username scritto
#      nel form nell'ID Discord reale)
#   3. invita il bot nel server con lo scope "bot" e i permessi
#      "View Channels" + "Send Messages" nel canale degli esiti
# Server e canali si scelgono poi da /dashboard/settings — qui va solo il token.
# Lascia vuoto per disattivare completamente le notifiche.
DISCORD_BOT_TOKEN=""

# ---- Discord OAuth ----
# Two features share this app: staff linking their Discord identity from
# /dashboard/profile, and — more importantly — forum sign-in. Forum members
# have no password at all: "Accedi con Discord" on /forum/accedi is the only
# way in for them, so leaving these empty locks the forum to read-only.
# Create an app at https://discord.com/developers/applications, add an OAuth2
# redirect matching exactly "{APP_URL}/api/auth/discord/callback" (e.g.
# http://localhost:3000/api/auth/discord/callback in dev), then copy its
# Client ID/Secret here.
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# mcsrvstat API base (no key required)
MCSRVSTAT_API_URL="https://api.mcsrvstat.us/2/play.venrixmc.uk"

# ---- LiteBans (optional) ----
# Connects read-only, directly to the MySQL database the LiteBans plugin
# writes to on the Minecraft server (NOT the venrixmc DATABASE_URL above —
# a separate database/schema, possibly on the same MySQL server, possibly
# a different host). Leave empty to disable the integration entirely.
LITEBANS_DATABASE_URL=""
# Table prefix LiteBans was installed with — "litebans_" is the plugin
# default (litebans_bans, litebans_mutes, litebans_warnings, litebans_kicks,
# litebans_history). Only change this if you customized it in LiteBans' config.
LITEBANS_TABLE_PREFIX="litebans_"
# The Ban ID players see in-game/on Discord (e.g. "F06494") is a formatted
# code, not the raw database id: a letter prefix + the id zero-padded to
# LITEBANS_BAN_ID_PAD digits. Adjust these to match your own ban message
# format so appeals can be matched back to the right LiteBans row.
LITEBANS_BAN_ID_PREFIX="F"
LITEBANS_BAN_ID_PAD="5"

# ---- AI detector (optional) ----
# Sapling API key from https://sapling.ai/user/settings (free plan: 50,000
# characters/day, 250,000/month). When set, every staff application is checked
# for AI-written text and the estimate is shown in the dashboard. Leave empty
# to disable.
SAPLING_API_KEY=""

# ---- App ----
NODE_ENV="development"
APP_URL="http://localhost:3000"
