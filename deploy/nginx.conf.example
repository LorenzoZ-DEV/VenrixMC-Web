# Host-level Nginx reverse proxy in front of the app container (which only
# listens on 127.0.0.1:3000, not publicly). Handles TLS termination.
#
# 1. Copy this to /etc/nginx/sites-available/venrixmc, edit server_name,
#    then: ln -s /etc/nginx/sites-available/venrixmc /etc/nginx/sites-enabled/
# 2. Get a cert: certbot --nginx -d venrixmc.uk -d www.venrixmc.uk
#    (certbot will rewrite this file to add the ssl_certificate lines and a
#    second server{} block that redirects :80 -> :443 — that's expected.)

server {
    listen 80;
    server_name venrixmc.uk www.venrixmc.uk;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
